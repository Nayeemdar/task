# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-in-production
APP_VERSION=1.0.0

# ── Database 1 — CRDB/ERDB (operational) ──────────────────────────────────────
# On-prem: polling_cursors, workflow_runs, workflow_definitions, connections
# Production: Encrypt=yes, TrustServerCertificate=no
DATABASE_URL=mssql+aioodbc://<user>:<password>@<server>.database.windows.net:1433/integration_platform?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no
# Local dev (docker SQL Server):
# DATABASE_URL=mssql+aioodbc://sa:YourStrong@Passw0rd@localhost:1433/integration_platform?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=no&TrustServerCertificate=yes

# ── Database 2 — BizOps Events (audit log) ────────────────────────────────────
# On-prem: separate append-only audit DB — bizops_events, bizops_workflow_runs
# Written by EventProcessor (on_prem/event_processor.py). Never touched by WorkflowEngine.
# Production: Encrypt=yes, TrustServerCertificate=no
BIZOPS_DATABASE_URL=mssql+aioodbc://<user>:<password>@<server>.database.windows.net:1433/bizops_events?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no
# Local dev (docker SQL Server):
# BIZOPS_DATABASE_URL=mssql+aioodbc://sa:YourStrong@Passw0rd@localhost:1433/bizops_events?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=no&TrustServerCertificate=yes

# ── Azure Service Bus ─────────────────────────────────────────────────────────
# AZURE_SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://...
AZURE_SERVICE_BUS_QUEUE_NAME=integration-events
AZURE_SERVICE_BUS_TOPIC_NAME=integration-events-topic

# ── Azure Key Vault ───────────────────────────────────────────────────────────
# AZURE_KEY_VAULT_URL=https://your-vault.vault.azure.net/
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_TENANT_ID=

# ── Azure Application Insights ────────────────────────────────────────────────
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...

# ── Salesforce ────────────────────────────────────────────────────────────────
SALESFORCE_CLIENT_ID=your_sf_connected_app_client_id
SALESFORCE_CLIENT_SECRET=your_sf_connected_app_client_secret
SALESFORCE_USERNAME=user@example.com
SALESFORCE_PASSWORD=yourpassword
SALESFORCE_SECURITY_TOKEN=yourtoken
SALESFORCE_INSTANCE_URL=https://login.salesforce.com
SALESFORCE_API_VERSION=v59.0

# ── Jira ──────────────────────────────────────────────────────────────────────
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=you@yourcompany.com
JIRA_API_TOKEN=your_jira_api_token

# ── UKG ───────────────────────────────────────────────────────────────────────
UKG_BASE_URL=https://yourcompany.kronos.net
UKG_APP_KEY=your_ukg_app_key
UKG_USERNAME=admin
UKG_PASSWORD=password

# ── Docebo ────────────────────────────────────────────────────────────────────
DOCEBO_BASE_URL=https://yourcompany.docebosaas.com
DOCEBO_CLIENT_ID=your_docebo_client_id
DOCEBO_CLIENT_SECRET=your_docebo_client_secret

# ── Sage Intacct ──────────────────────────────────────────────────────────────
SAGE_COMPANY_ID=YOURCOMPANY
SAGE_USER_ID=apiuser
SAGE_USER_PASSWORD=password
SAGE_CLIENT_ID=your_sage_client_id
SAGE_CLIENT_SECRET=your_sage_client_secret

# ── On-Prem Metrics / Health Server ──────────────────────────────────────────
# GET /health   → JSON {"status": "ok", "uptime_s": …}
# GET /metrics  → Prometheus text format (scraped by Prometheus container)
METRICS_HOST=0.0.0.0
METRICS_PORT=9090

# ── Webhook Security ──────────────────────────────────────────────────────────
WEBHOOK_SECRET=your-webhook-signing-secret

# ── Polling ───────────────────────────────────────────────────────────────────
POLLING_DEFAULT_INTERVAL_SECONDS=300
POLLING_MAX_WORKERS=10

# ── Retry / Circuit Breaker ───────────────────────────────────────────────────
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=1.0
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60
